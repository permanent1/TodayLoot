# 复制本文件为 .env.local 后按需填写。不要提交真实密钥。
# 带 NEXT_PUBLIC_ 前缀的变量会打包进浏览器，禁止放任何密钥。

# AI 工作模式：mock（默认，可完整演示）| live（真实视觉识别）
AI_MODE=mock
# 真实识别的第二道开关，必须同时为 true 才会调用付费接口
ALLOW_LIVE_APPRAISE=false

# 阿里云百炼 / 千问（仅服务端读取）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen3.8-flash
# 实际 base URL 以控制台当前官方文档为准
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tripo 3D：默认关闭；开启前需完成服务端额度核验
ENABLE_TRIPO=false
TRIPO_API_KEY=your_tripo_api_key_here
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3

# 服务端保护项
DEMO_ACCESS_CODE=
MAX_IMAGE_MB=8
MAX_DAILY_LIVE_REQUESTS=20
